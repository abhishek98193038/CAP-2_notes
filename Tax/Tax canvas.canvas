	"nodes":[
		{"id":"61ba3bf9f039e02d","x":-3040,"y":-1360,"width":2045,"height":1128,"type":"group","label":"Untitled group"},
		{"id":"9a8db34344e264c0","type":"text","text":"Person\nhaving \ntaxable income during the income year","x":-660,"y":145,"width":164,"height":145},
		{"id":"63614f1b8dd2b34c","x":-920,"y":80,"width":95,"height":60,"type":"text","text":"Person"},
		{"id":"5d00080d3fbfaf54","x":-980,"y":240,"width":164,"height":60,"type":"text","text":"Taxable income"},
		{"id":"a7f4d8996fc0b283","type":"text","text":"Person having income subject to final withholding","x":640,"y":140,"width":245,"height":60},
		{"id":"b0b3f850ae33b0df","x":640,"y":345,"width":250,"height":131,"type":"text","text":"<u>Types of income</u>\n1. Advance tax\n2. Final tax\n3. withholding tax"},
		{"id":"477f5a1a31fc38f0","type":"text","text":"Foreign permanent establishment\nof \nnon resident \nrepatriating income during the income year","x":-90,"y":153,"width":300,"height":147},
		{"id":"eaea3b4100550d70","x":-95,"y":411,"width":310,"height":96,"type":"text","text":"5% tax\nsimilar to dividend \nsimilar to depreciation on building"},
		{"id":"2524d022a0fc3936","x":-420,"y":298,"width":187,"height":60,"type":"text","text":"Foreign permanent establishment"},
		{"id":"cdd3d8bdd67f8863","x":-380,"y":167,"width":149,"height":50,"type":"text","text":"non resident"},
		{"id":"939e064ba6653fed","type":"text","text":"Natural person / Individual\n- Individual (manxe)\n- Sole proprietorship\n- Couple u/s 50 (optional)\n\t- Resident widow/widower taking care of dependent\n\t- Resident Natural person + Resident spouse","x":-3020,"y":-1120,"width":380,"height":240},
		{"id":"1d6727339c0d9c52","type":"text","text":"Definition of person","x":-2720,"y":-1340,"width":250,"height":60},
		{"id":"0cc9808d147f6f4e","type":"text","text":"\"**Partnership**\" means a firm consisting of $\\textless$ 20 partners, whether registered under the law in force or not.","x":-2616,"y":-819,"width":283,"height":129},
		{"id":"6457ce7807a26c14","type":"text","text":"Partnership","x":-2600,"y":-949,"width":250,"height":60},
		{"id":"49aafb7f68403a73","type":"text","text":"Entity","x":-2289,"y":-1119,"width":250,"height":60},
		{"id":"1f0048434441d4b7","type":"text","text":"Public international organization established by treaty ","x":-2084,"y":-532,"width":244,"height":72},
		{"id":"fdbaca8f879754e3","type":"text","text":"foreign Permanent establishment of Non resident","x":-2084,"y":-432,"width":183,"height":88},
		{"id":"d30eb6c2dd897d7d","type":"text","text":"\"**Trust**\" means an arrangement whereby a [trustee](app://obsidian.md/Income%20tax%20act%202002\\(2058\\)#^rjyozx) holds any property","x":-1964,"y":-979,"width":260,"height":120},
		{"id":"403eee933692bb6e","type":"text","text":"Permanent establishment means: A place where\n1. any person carries on a business fully or partly, or through any agent ( except general agent)\n2. any person's main equipment or main machinery is situated or used or installed\n3. any person has delivered technical , professional or consultancy service through an employee or in any other manner for $\\textgreater$ 90 days in a period of 12 month\nref: [[Income tax act 2002(2058)#^7xt4k4]]","x":-1760,"y":-532,"width":447,"height":280},
		{"id":"79b92a45f6e39c3d","type":"text","text":"- company established under prevailing company laws\n- corporate body established under prevailing law (eg:ICAN)\n- unincorporated association / society\n- partnership with $\\geq$ 20 partners\n- Retirement fund\n- cooperative \n- unit trust\n- joint venture\nref: [[Income tax act 2002(2058)#^azrvnb]]","x":-1640,"y":-899,"width":520,"height":269},
		{"id":"8ba6543d86950ccb","type":"text","text":"\"**Trustee**\" means an individual, trust (Guthi) or other body corporate who, individually or jointly with other individual, trust (Guthi) or corporate body, holds a property in trust, and the term also includes the following person:\n\t(1) The operator or administrator of the assets of a deceased,\n\t(2) A liquidator, recipient or trustee,\n\t(3) Any person who protects, directs, controls or manages the assets of an incapacitated person in personal or official capacity,\n\t(4) Any person who manages the assets under a private enterprise or similar other enterprise, and\n\t(5) Any other person in a position similar to that of the person as referred to in clauses (1), (2), (3) and (4).\nref: [[Income tax act 2002(2058)#^rjyozx]]","x":-1536,"y":-1259,"width":521,"height":341},
		{"id":"1215fcb612b35ef9","type":"text","text":"Trust","x":-2084,"y":-949,"width":84,"height":60},
		{"id":"d974bc7a9011c947","type":"text","text":"Company","x":-2084,"y":-849,"width":120,"height":60},
		{"id":"4c72a1510806e7b3","type":"text","text":"government (central, provincial, local)\nDistrict co-ordination committee","x":-2084,"y":-749,"width":327,"height":77},
